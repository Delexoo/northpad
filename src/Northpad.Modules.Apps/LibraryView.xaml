<UserControl x:Class="Northpad.Modules.Apps.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Import" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Command="{Binding ImportCommand}"/>
                    <Button Content="Export" Style="{StaticResource QuietButton}" Margin="0,0,0,8" Command="{Binding ExportCommand}"/>
                    <Button Content="Delete" Style="{StaticResource QuietButton}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
                <ListBox Style="{StaticResource FlatList}" ItemsSource="{Binding Items}" SelectionChanged="OnSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource Brush.Muted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <StackPanel Grid.Column="1" Margin="28,24,28,24">
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Image Source="{Binding Image}" MaxHeight="480" Stretch="Uniform" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</UserControl>
