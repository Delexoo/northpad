<UserControl x:Class="Northpad.Modules.Apps.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="28,24,28,32">
            <TextBlock Text="Calendar" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Events stay on this computer. Dates are stored so the month can be drawn. Titles are encrypted." Style="{StaticResource MutedText}" Margin="0,6,0,16"/>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Previous" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding PreviousMonthCommand}"/>
                    <Button Content="Next" Style="{StaticResource QuietButton}" Command="{Binding NextMonthCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding MonthLabel}" FontSize="18" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Weekdays}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="2" Height="42" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InMonth}" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Active}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Selected day" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
            <ListBox Style="{StaticResource FlatList}" MaxHeight="160" ItemsSource="{Binding Events}" SelectionChanged="OnEventSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Style="{StaticResource InputText}" Margin="0,12,0,8" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event title"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,0,0,8" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event time"/>
            <TextBox Style="{StaticResource InputText}" AcceptsReturn="True" MinHeight="72" Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Event details"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding SaveEventCommand}"/>
                <Button Content="New" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding NewEventCommand}"/>
                <Button Content="Delete" Style="{StaticResource QuietButton}" Command="{Binding DeleteEventCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
