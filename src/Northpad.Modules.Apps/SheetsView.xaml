<UserControl x:Class="Northpad.Modules.Apps.SheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sheets" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListBox Style="{StaticResource FlatList}" ItemsSource="{Binding Items}" SelectionChanged="OnSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"/>
                <TextBox Style="{StaticResource InputText}" Margin="0,8,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sheet name"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                    <Button Content="Add row" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding AddRowCommand}"/>
                    <Button Content="New" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding NewItemCommand}"/>
                    <Button Content="Delete" Style="{StaticResource QuietButton}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding ColumnTotal}" Margin="0,8,0,0"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="A" Binding="{Binding C0, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="B" Binding="{Binding C1, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="C" Binding="{Binding C2, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="D" Binding="{Binding C3, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="E" Binding="{Binding C4, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="F" Binding="{Binding C5, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="G" Binding="{Binding C6, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="H" Binding="{Binding C7, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
