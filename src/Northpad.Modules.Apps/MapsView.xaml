<UserControl x:Class="Northpad.Modules.Apps.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Maps" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Allow network" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding AllowNetworkCommand}" Visibility="{Binding NetworkAllowed, Converter={StaticResource InverseBool}}"/>
                <Button Content="Left" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding PanLeftCommand}"/>
                <Button Content="Right" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding PanRightCommand}"/>
                <Button Content="Up" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding PanUpCommand}"/>
                <Button Content="Down" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding PanDownCommand}"/>
                <Button Content="Zoom in" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding ZoomInCommand}"/>
                <Button Content="Zoom out" Style="{StaticResource QuietButton}" Command="{Binding ZoomOutCommand}"/>
            </StackPanel>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Find" Style="{StaticResource QuietButton}" Command="{Binding FindPlaceCommand}"/>
                <TextBox Style="{StaticResource InputText}" Margin="0,0,8,0" Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Place"/>
            </DockPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Width="180" Height="180" Stretch="Fill" Source="{Binding Image}" Margin="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
