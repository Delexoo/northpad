<UserControl x:Class="Northpad.Modules.Apps.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="28,24,28,32">
            <TextBlock Text="Translate" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="80" Style="{StaticResource InputText}" Margin="0,0,8,0" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="From language"/>
                <TextBox Width="80" Style="{StaticResource InputText}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To language"/>
            </StackPanel>
            <TextBox Style="{StaticResource PlainText}" AcceptsReturn="True" MinHeight="90" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Text to translate"/>
            <Button Content="Translate" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,8" Command="{Binding TranslateCommand}"/>
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="18" Margin="0,4,0,20"/>
            <TextBlock Text="Glossary" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,0,0,8" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Phrase"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,0,0,8" Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Meaning"/>
            <Button Content="Save phrase" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Command="{Binding AddPhraseCommand}"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,18,0,8" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="LibreTranslate address"/>
            <TextBlock Text="Leave this empty to stay offline. A local LibreTranslate address such as http://127.0.0.1:5000 is allowed." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Glossary}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,6">
                            <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource QuietButton}" Command="{Binding DataContext.DeletePhraseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
