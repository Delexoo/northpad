<UserControl x:Class="Northpad.Modules.Apps.WalletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Wallet" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Total, StringFormat=Total {0}}" Margin="0,4,0,12"/>
                <ListBox Style="{StaticResource FlatList}" ItemsSource="{Binding Items}" SelectionChanged="OnSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <StackPanel Grid.Column="1" Margin="28,24,28,24">
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,0,0,8" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Label"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,0,0,8" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Amount"/>
            <TextBox Style="{StaticResource PlainText}" AcceptsReturn="True" MinHeight="100" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Note"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <Button Content="New" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding NewItemCommand}"/>
                <Button Content="Delete" Style="{StaticResource QuietButton}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
