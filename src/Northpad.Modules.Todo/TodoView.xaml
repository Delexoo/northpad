<UserControl x:Class="Northpad.Modules.Todo.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="16,20,12,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Todo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource InputText}" Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New task"/>
                    <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding AddTaskCommand}"/>
                </Grid>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Open" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding ShowOpenCommand}"/>
                    <Button Content="Done" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Command="{Binding ShowDoneCommand}"/>
                    <Button Content="All" Style="{StaticResource QuietButton}" Command="{Binding ShowAllCommand}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding EmptyMessage}" Margin="4,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox Style="{StaticResource FlatList}"
                         ItemsSource="{Binding FilteredTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=OneWay}"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <StackPanel Grid.Column="1" Margin="28,20,28,16">
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource QuietButton}" Command="{Binding DeleteTaskCommand}" AutomationProperties.Name="Delete task"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Title" Style="{StaticResource MutedText}"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,6,0,14" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Task title"/>
            <TextBlock Text="Details" Style="{StaticResource MutedText}"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,6,0,14" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                     VerticalScrollBarVisibility="Auto" Text="{Binding EditorDetails, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Task details"/>
            <TextBlock Text="Due date" Style="{StaticResource MutedText}"/>
            <TextBox Style="{StaticResource InputText}" Margin="0,6,0,4" Width="180" HorizontalAlignment="Left"
                     Text="{Binding DueText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Due date"/>
            <TextBlock Text="Use 2026-10-09, or leave the date empty." Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
            <TextBlock Text="Priority" Style="{StaticResource MutedText}"/>
            <ComboBox Margin="0,6,0,14" Width="180" HorizontalAlignment="Left"
                      ItemsSource="{Binding Priorities}"
                      SelectedItem="{Binding EditorPriority}"
                      AutomationProperties.Name="Priority"/>
            <CheckBox Content="Completed" IsChecked="{Binding EditorCompleted}" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
