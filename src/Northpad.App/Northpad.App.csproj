<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Northpad.App</RootNamespace>
    <AssemblyName>Northpad</AssemblyName>
    <Version>0.1.0</Version>
    <Product>northpad</Product>
    <Company>Northpad</Company>
    <Description>A local-first Windows workspace.</Description>
    <ApplicationTitle>northpad</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Northpad.Core\Northpad.Core.csproj" />
    <ProjectReference Include="..\Northpad.Modules.Notes\Northpad.Modules.Notes.csproj" />
    <ProjectReference Include="..\Northpad.Modules.Todo\Northpad.Modules.Todo.csproj" />
  </ItemGroup>

</Project>
