<Window x:Class="Northpad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="northpad"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <RadioButton DockPanel.Dock="Bottom"
                             Style="{StaticResource NavButton}"
                             Margin="0,4,0,16"
                             GroupName="Nav"
                             ToolTip="Settings"
                             AutomationProperties.Name="Settings"
                             IsChecked="{Binding ActiveDestination, Converter={StaticResource DestinationConverter}, ConverterParameter=settings, Mode=OneWay}"
                             Command="{Binding OpenSettingsCommand}">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="18" Height="18" Stretch="Uniform"
                          Data="M4,7 H20 M4,12 H20 M4,17 H20 M8,7 V5 M14,12 V10 M10,17 V15"/>
                </RadioButton>
                <StackPanel Margin="0,16,0,0">
                    <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="N" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   AutomationProperties.Name="northpad"/>
                    </Border>
                    <RadioButton Style="{StaticResource NavButton}"
                                 GroupName="Nav"
                                 ToolTip="Home"
                                 AutomationProperties.Name="Home"
                                 IsEnabled="{Binding IsUnlocked}"
                                 IsChecked="{Binding ActiveDestination, Converter={StaticResource DestinationConverter}, ConverterParameter=home, Mode=OneWay}"
                                 Command="{Binding GoHomeCommand}">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"
                              Data="M4,11 L12,4 L20,11 V20 H15 V14 H9 V20 H4 Z"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 GroupName="Nav"
                                 ToolTip="Search"
                                 AutomationProperties.Name="Search"
                                 IsEnabled="{Binding IsUnlocked}"
                                 IsChecked="{Binding ActiveDestination, Converter={StaticResource DestinationConverter}, ConverterParameter=search, Mode=OneWay}"
                                 Command="{Binding OpenSearchCommand}">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"
                              Data="M10,4 A6,6 0 1 1 9.9,4 M15,15 L20,20"/>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Brush.Window}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>
