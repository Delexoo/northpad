<UserControl x:Class="Northpad.App.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left">
                <TextBlock Text="N" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="northpad" FontSize="28" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <TextBlock Text="This workspace is locked." Style="{StaticResource MutedText}" Margin="0,6,0,20"/>
            <TextBlock x:Name="SecretLabel" Text="Passphrase" Margin="0,0,0,6"/>
            <PasswordBox x:Name="SecretBox" Style="{StaticResource InputPassword}" KeyDown="OnKeyDown"/>
            <TextBox x:Name="RecoveryBox" Style="{StaticResource InputText}" Visibility="Collapsed" AcceptsReturn="False" KeyDown="OnKeyDown"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button Content="Unlock" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnUnlock" IsDefault="True"/>
            <Button x:Name="ModeButton" Content="Use a recovery key" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnToggleMode"/>
        </StackPanel>
    </Grid>
</UserControl>
