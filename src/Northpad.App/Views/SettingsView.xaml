<UserControl x:Class="Northpad.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="36,32,36,40">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,28,0,8"/>
            <TextBlock Text="Northpad follows Windows unless you choose a theme. High contrast uses the system colors." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="System" GroupName="Theme" Margin="0,0,16,0"
                             IsChecked="{Binding Theme, Converter={StaticResource ThemeMatch}, ConverterParameter=system, Mode=OneWay}"
                             Command="{Binding ChooseThemeCommand}" CommandParameter="system"/>
                <RadioButton Content="Light" GroupName="Theme" Margin="0,0,16,0"
                             IsChecked="{Binding Theme, Converter={StaticResource ThemeMatch}, ConverterParameter=light, Mode=OneWay}"
                             Command="{Binding ChooseThemeCommand}" CommandParameter="light"/>
                <RadioButton Content="Dark" GroupName="Theme"
                             IsChecked="{Binding Theme, Converter={StaticResource ThemeMatch}, ConverterParameter=dark, Mode=OneWay}"
                             Command="{Binding ChooseThemeCommand}" CommandParameter="dark"/>
            </StackPanel>

            <TextBlock Text="Privacy and security" Style="{StaticResource SectionTitle}" Margin="0,28,0,8"/>
            <TextBlock Text="{Binding ProtectionSummary}" Style="{StaticResource MutedText}"/>
            <TextBlock Text="Note text and task text are encrypted with AES-256-GCM before they are written. Timestamps, task completion, priority, and due dates are stored unencrypted so lists can be ordered. Northpad does not send this data anywhere."
                       Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
            <WrapPanel>
                <Button Content="Set passphrase" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                        Command="{Binding SetPassphraseCommand}"
                        Visibility="{Binding PassphraseEnabled, Converter={StaticResource InverseBool}}"/>
                <Button Content="Change passphrase" Style="{StaticResource QuietButton}" Margin="0,0,8,8"
                        Command="{Binding ChangePassphraseCommand}"
                        Visibility="{Binding PassphraseEnabled, Converter={StaticResource BoolToVis}}"/>
                <Button Content="New recovery key" Style="{StaticResource QuietButton}" Margin="0,0,8,8"
                        Command="{Binding RotateRecoveryKeyCommand}"
                        Visibility="{Binding PassphraseEnabled, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Remove passphrase" Style="{StaticResource QuietButton}" Margin="0,0,8,8"
                        Command="{Binding RemovePassphraseCommand}"
                        Visibility="{Binding PassphraseEnabled, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Lock" Style="{StaticResource QuietButton}" Margin="0,0,8,8"
                        Command="{Binding LockCommand}"
                        Visibility="{Binding PassphraseEnabled, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>

            <TextBlock Text="Local storage" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <TextBlock Text="{Binding StoragePath}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="The database and wrapped vault key live in this folder. There is no account and no cloud copy." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button Content="Open folder" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Command="{Binding OpenFolderCommand}"/>
                <Button Content="Export backup" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Command="{Binding ExportBackupCommand}"/>
                <Button Content="Delete local data" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Command="{Binding DeleteWorkspaceCommand}"/>
            </WrapPanel>

            <TextBlock Text="Account" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <TextBlock Text="Northpad does not use an account. Nothing on this screen signs you in." Style="{StaticResource MutedText}"/>

            <TextBlock Text="Synchronization" Style="{StaticResource SectionTitle}" Margin="0,28,0,8"/>
            <TextBlock Text="Synchronization is not available. Northpad does not upload notes, tasks, or keys." Style="{StaticResource MutedText}"/>

            <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,28,0,8"/>
            <TextBlock Text="{Binding VersionText, StringFormat=northpad {0}}"/>
            <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <TextBlock Text="There is no telemetry in this version." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
