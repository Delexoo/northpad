<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#F5F5F5" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1A1A1A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#5E5E5E" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#E4E4E4" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#EFEFEF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Active" Color="#E6E6E6" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#1A1A1A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#333333" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#8C2F2F" po:Freeze="False"/>
</ResourceDictionary>
